    "blockbench",
    "ai-video",
    "kling",
    "seedance",
    "wan",
    "sora",
    "short-video",
    "pi-package"
  ],
  "scripts": {
    "voxel": "node scripts/voxel_spec.mjs",
    "compile": "node scripts/shot_compiler.mjs",
    "check": "node scripts/drift_check.mjs",
    "render": "node scripts/render_preview.mjs",
    "validate": "node scripts/validate_skill.mjs",
    "test": "node --test tests/run_tests.mjs"
