  "private": false,
  "type": "module",
  "description": "Generate Minecraft-style voxel character, mob, and block short videos with locked 8x8x8/16x16x16 pixel-grid geometry, 9:16 storyboards, and model-specific prompts.",
  "license": "MIT",
  "repository": "github:yuzhang-zhong/minecraft-style-video",
  "keywords": [
    "agent-skill",
    "codex-skill",
    "copilot-skill",
    "claude-skill",
    "minecraft",
